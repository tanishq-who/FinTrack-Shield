# FinTrack Shield — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# JWT — MUST be a strong random string (≥ 32 chars)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Database file path (relative to src/)
DB_PATH=./data/fintrack.db

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
